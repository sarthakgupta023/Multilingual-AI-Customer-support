# VoiceDesk Server Environment Configuration

PORT=4000
NODE_ENV=development

# 1. Gnani AI Credentials (app.gnani.ai/voice)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_FILE_URL=https://api.vachana.ai/api/v1/tts/inference

# 2. Supabase pgvector Database
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# 3. LLM API (OpenAI or Gemini or compatible)
OPENAI_API_KEY=your_openai_or_groq_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 4. Mock / Development flags (allows full testing without burning Gnani credits)
MOCK_GNANI=false
MOCK_LLM=false
USE_LOCAL_VECTOR_STORE=true
