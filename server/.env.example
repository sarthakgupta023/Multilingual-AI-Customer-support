# Copy to server/.env and fill in local values. Never commit credentials.
# PostgreSQL must have pgvector installed. In production use TLS with
# certificate verification (sslmode=verify-full and sslrootcert).
LOCAL_DB_PASSWORD=CHANGE_ME_USE_ALPHANUMERIC
DATABASE_URL=postgresql://nova_dev:${LOCAL_DB_PASSWORD}@127.0.0.1:55432/nova_dev
ADMIN_PASSWORD=
NODE_ENV=development

# Gnani speech APIs. Leave GNANI_API_KEY blank to run without voice input.
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_MODEL=timbre-v3.0
GNANI_VOICE=Shivani
MOCK_GNANI=false

# Choose one configured language-model provider. Leave keys blank for mock mode.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# HF_TOKEN=
# OPENAI_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
MOCK_LLM=false
